package org.bukkit;

import java.util.function.Function;

/** A game rule: its registry key, the type plugins read it as, and -- for the
 * legacy camelCase constants that no longer name a rule of their own -- how a
 * value is carried to the renamed rule and back.
 *
 * Generated by dev/gen-game-rules.py from this template; the constants come
 * from the extracted registry and from Paper's legacy alias table.
 */
public class GameRule<T> implements Keyed {
    /** The canonical rule per registry path, filled as `GameRules` loads. */
    private static final java.util.Map<String, GameRule<?>> REGISTERED = new java.util.LinkedHashMap<>();

    private final NamespacedKey key;
    private final Class<T> type;
    private final Class<?> storedType;
    private final Function<T, ?> toStored;
    private final Function<Object, T> fromStored;
    private final boolean bridged;

    @SuppressWarnings("unchecked")
    private GameRule(String key, Class<T> type, Class<?> storedType, Function<T, ?> toStored,
            Function<?, T> fromStored, boolean bridged) {
        this.key = NamespacedKey.minecraft(key);
        this.type = type;
        this.storedType = storedType;
        this.toStored = toStored;
        this.fromStored = (Function<Object, T>) fromStored;
        this.bridged = bridged;
    }

    /** Called by `GameRules` for each registry entry. */
    static <T> GameRule<T> register(String key, Class<T> type) {
        GameRule<T> rule = alias(key, type);
        REGISTERED.put(key, rule);
        return rule;
    }

    /** A legacy name for a rule that was renamed and kept its meaning.
     * A separate instance, equal to the canonical one, because `GameRules`
     * cannot be read while this class is still being initialised. */
    private static <T> GameRule<T> alias(String key, Class<T> type) {
        return new GameRule<>(key, type, type, Function.identity(), Function.identity(), false);
    }

    /** A legacy rule whose meaning was inverted or folded into another. */
    private static <S> GameRule<Boolean> bridge(String key, Class<S> stored,
            Function<Boolean, S> toStored, Function<S, Boolean> fromStored) {
        return new GameRule<>(key, Boolean.class, stored, toStored, fromStored, true);
    }

    @Override
    public NamespacedKey getKey() {
        return key;
    }

    /** The registry path, which is what 26.x calls a rule by. */
    @Deprecated
    public String getName() {
        return key.getKey();
    }

    public Class<T> getType() {
        return type;
    }

    /** Parses a value as the world stores it, in this rule's own terms. */
    public T parse(String stored) {
        if (stored == null) return null;
        Object raw;
        try {
            if (storedType == Boolean.class) raw = Boolean.valueOf(stored);
            else if (storedType == Integer.class) raw = Integer.valueOf(stored);
            else return null;
        } catch (NumberFormatException ignored) {
            return null;
        }
        return fromStored.apply(raw);
    }

    /** The value the world stores for `value` of this rule. */
    public String toStored(T value) {
        return String.valueOf(toStored.apply(value));
    }

    public static GameRule<?> getByName(String rule) {
        if (rule == null) return null;
        NamespacedKey parsed = NamespacedKey.fromString(rule);
        if (parsed == null || !"minecraft".equals(parsed.getNamespace())) return null;
        return registered().get(parsed.getKey());
    }

    public static GameRule<?>[] values() {
        return registered().values().toArray(new GameRule<?>[0]);
    }

    private static java.util.Map<String, GameRule<?>> registered() {
        GameRules.load();
        return REGISTERED;
    }

    @Override
    public boolean equals(Object other) {
        if (this == other) return true;
        return other instanceof GameRule<?> rule && !bridged && !rule.bridged
            && key.equals(rule.key) && type == rule.type;
    }

    @Override
    public int hashCode() {
        return key.hashCode();
    }

    @Override
    public String toString() {
        return "GameRule{key=" + key + ", type=" + type.getSimpleName() + "}";
    }

    // @LEGACY@
}
