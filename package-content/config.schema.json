{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FotonConfig",
  "description": "Configuration schema for Foton Minecraft server",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "description": "Server configuration",
      "properties": {
        "server_port": {
          "type": "integer",
          "description": "Server port",
          "minimum": 1,
          "maximum": 65000,
          "default": 25565
        },
        "max_players": {
          "type": "integer",
          "description": "Maximum number of players allowed on the server",
          "minimum": 1,
          "maximum": 2147483647,
          "default": 20
        },
        "allow_extended_view_distance": {
          "type": "boolean",
          "description": "Allow view_distance above vanilla's 32-chunk cap, up to Foton's 128-chunk cap",
          "default": false
        },
        "view_distance": {
          "type": "integer",
          "description": "Maximum view distance in chunks. Normally 1-32; 1-128 when allow_extended_view_distance is true.",
          "minimum": 1,
          "maximum": 128,
          "default": 10
        },
        "simulation_distance": {
          "type": "integer",
          "description": "Maximum simulation distance in chunks",
          "minimum": 1,
          "maximum": 128,
          "default": 10
        },
        "max_chained_neighbor_updates": {
          "type": "integer",
          "description": "Maximum queued neighbor-update tasks in one chained run. Negative values disable the limit.",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 1000000
        },
        "online_mode": {
          "type": "boolean",
          "description": "Whether to use Mojang's authentication service",
          "default": true
        },
        "auth_server": {
          "type": "string",
          "description": "Optional authentication endpoint for online-mode hasJoined checks. Omit to use Mojang's session server.",
          "format": "uri"
        },
        "profile_server": {
          "type": "string",
          "description": "Optional endpoint for online-mode player name-to-profile lookups. Omit to use Mojang's profile service.",
          "format": "uri"
        },
        "services_server": {
          "type": "string",
          "description": "Optional endpoint for Mojang-compatible service public keys. Omit to use Mojang's services endpoint.",
          "format": "uri"
        },
        "encryption": {
          "type": "boolean",
          "description": "Whether to enable encryption for client-server communication. Required in online mode.",
          "default": true
        },
        "allow_flight": {
          "type": "boolean",
          "description": "Whether the server allows unauthorized client flight",
          "default": false
        },
        "motd": {
          "type": "string",
          "description": "Message of the day displayed in server lists",
          "default": "A Foton Server"
        },
        "use_favicon": {
          "type": "boolean",
          "description": "Whether to use a custom favicon for the server",
          "default": true
        },
        "favicon": {
          "type": "string",
          "description": "Path to the favicon file (PNG format, 64x64 pixels)",
          "default": "config/favicon.png"
        },
        "enforce_secure_chat": {
          "type": "boolean",
          "description": "Whether to enforce secure chat",
          "default": false
        },
        "chat_spam_threshold_seconds": {
          "type": "integer",
          "description": "Vanilla chat spam threshold window in seconds; values <= 0 disable throttling",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 10
        },
        "command_spam_threshold_seconds": {
          "type": "integer",
          "description": "Vanilla command spam threshold window in seconds; values <= 0 disable throttling",
          "minimum": -2147483648,
          "maximum": 2147483647,
          "default": 10
        },
        "compression": {
          "type": "object",
          "description": "Compression settings",
          "properties": {
            "threshold": {
              "type": "integer",
              "description": "Compression threshold in bytes",
              "minimum": 256,
              "maximum": 2147483647,
              "default": 256
            },
            "level": {
              "type": "integer",
              "description": "Compression level (1 = fastest, 9 = best compression)",
              "minimum": 1,
              "maximum": 9,
              "default": 4
            }
          },
          "required": [
            "threshold",
            "level"
          ],
          "additionalProperties": false
        },
        "server_links": {
          "type": "object",
          "description": "Server links configuration",
          "properties": {
            "enable": {
              "type": "boolean",
              "description": "Enable the server links feature",
              "default": false
            },
            "links": {
              "type": "array",
              "description": "List of server links to display in the server menu",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "description": "Label for the link - either a built-in type (string) or custom TextComponent (object)",
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "bug_report",
                          "community_guidelines",
                          "support",
                          "status",
                          "feedback",
                          "community",
                          "website",
                          "forums",
                          "news",
                          "announcements"
                        ],
                        "description": "Built-in server link type"
                      },
                      {
                        "type": "object",
                        "description": "Custom text component with formatting",
                        "properties": {
                          "text": {
                            "type": "string",
                            "description": "The text content"
                          },
                          "color": {
                            "type": "string",
                            "description": "Text color (named color or #RRGGBB hex)",
                            "pattern": "^(#[0-9a-fA-F]{6}|black|dark_blue|dark_green|dark_aqua|dark_red|dark_purple|gold|gray|dark_gray|blue|green|aqua|red|light_purple|yellow|white|reset)$"
                          },
                          "bold": {
                            "type": "boolean",
                            "description": "Make text bold"
                          },
                          "italic": {
                            "type": "boolean",
                            "description": "Make text italic"
                          },
                          "underlined": {
                            "type": "boolean",
                            "description": "Underline text"
                          },
                          "strikethrough": {
                            "type": "boolean",
                            "description": "Strikethrough text"
                          },
                          "obfuscated": {
                            "type": "boolean",
                            "description": "Obfuscate text"
                          }
                        },
                        "required": [
                          "text"
                        ],
                        "additionalProperties": true
                      }
                    ]
                  },
                  "url": {
                    "type": "string",
                    "description": "The URL for this link",
                    "format": "uri"
                  }
                },
                "required": [
                  "label",
                  "url"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false
        },
        "rcon": {
          "type": "object",
          "description": "Remote administration over the Source Rcon protocol",
          "properties": {
            "enable": {
              "type": "boolean",
              "description": "Whether the rcon port is opened at all",
              "default": false
            },
            "port": {
              "type": "integer",
              "description": "Port rcon listens on",
              "minimum": 1,
              "maximum": 65535,
              "default": 25575
            },
            "password": {
              "type": "string",
              "description": "Password every rcon client must send before it may run a command",
              "default": ""
            }
          },
          "additionalProperties": false
        },
        "bedrock": {
          "type": "object",
          "description": "Letting Bedrock Edition players in, through a Geyser this server runs",
          "properties": {
            "enable": {
              "type": "boolean",
              "description": "Whether Geyser is started and the Bedrock port opened at all",
              "default": false
            },
            "port": {
              "type": "integer",
              "description": "UDP port Bedrock clients connect to; 0 shares server_port. Trade-off: Bedrock's Add Server dialog pre-fills 19132, so sharing the Java port means typing the port in by hand -- set this to 19132 explicitly for that automatic experience instead",
              "minimum": 0,
              "maximum": 65535,
              "default": 0
            },
            "motd": {
              "type": "string",
              "description": "What Bedrock clients see in the server list; empty reuses the server MOTD",
              "default": ""
            },
            "username_prefix": {
              "type": "string",
              "description": "Prepended to a Bedrock player's gamertag so it cannot collide with a Java player's name",
              "default": "."
            },
            "trusted_proxies": {
              "type": "array",
              "description": "Addresses a Floodgate identity handshake is accepted from",
              "items": {
                "type": "string"
              },
              "default": ["127.0.0.1", "::1"]
            },
            "java_home": {
              "type": "string",
              "description": "A JDK or JRE for Geyser; empty means JAVA_HOME, then java on the path",
              "default": ""
            },
            "jar_path": {
              "type": "string",
              "description": "An operator-supplied Geyser jar; empty means fetch the pinned build",
              "default": ""
            }
          },
          "additionalProperties": false
        },
        "threads": {
          "type": "object",
          "description": "Optional worker counts for server thread pools. 0 or omitted uses each pool's automatic default.",
          "properties": {
            "main_runtime": {
              "type": "integer",
              "description": "Worker threads for the primary Tokio runtime",
              "minimum": 0,
              "default": 0
            },
            "chunk_runtime": {
              "type": "integer",
              "description": "Worker threads for the chunk Tokio runtime",
              "minimum": 0,
              "default": 0
            },
            "packet_workers": {
              "type": "integer",
              "description": "Persistent workers for inter-tick gameplay packet processing",
              "minimum": 0,
              "default": 0
            },
            "chunk_generation": {
              "type": "integer",
              "description": "Worker threads for the Rayon chunk generation pool",
              "minimum": 0,
              "default": 0
            },
            "chunk_encoding": {
              "type": "integer",
              "description": "Worker threads for the Rayon chunk encoding pool",
              "minimum": 0,
              "default": 0
            }
          },
          "additionalProperties": false
        },
        "bug_reports": {
          "type": "object",
          "description": "Where player-filed bug reports are sent, on top of the local file",
          "properties": {
            "webhook_url": {
              "type": "string",
              "description": "Endpoint each filed report is posted to; unset keeps reports local"
            },
            "webhook_token": {
              "type": "string",
              "description": "Optional bearer token sent with each post"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "server_port",
        "max_players",
        "view_distance",
        "simulation_distance",
        "online_mode",
        "encryption",
        "motd",
        "use_favicon",
        "favicon"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "allow_extended_view_distance": {
                "const": true
              }
            },
            "required": [
              "allow_extended_view_distance"
            ]
          },
          "then": {
            "properties": {
              "view_distance": {
                "maximum": 128
              }
            }
          },
          "else": {
            "properties": {
              "view_distance": {
                "maximum": 32
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "online_mode": {
                "const": true
              }
            },
            "required": [
              "online_mode"
            ]
          },
          "then": {
            "properties": {
              "encryption": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "log": {
      "type": "object",
      "description": "Logging configuration",
      "properties": {
        "log_path": {
          "type": "string",
          "description": "Path where store the log files and history",
          "default": "./.logs"
        },
        "log_level": {
          "type": "string",
          "description": "The level of information the logger will show",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info"
        },
        "time": {
          "type": "string",
          "description": "Time format: none, date (HH:MM:SS:mmm), or uptime (seconds since start)",
          "enum": [
            "none",
            "date",
            "uptime"
          ],
          "default": "uptime"
        },
        "module_path": {
          "type": "boolean",
          "description": "Whether the module_path of the log should be displayed",
          "default": false
        },
        "extra": {
          "type": "boolean",
          "description": "Whether the extra data of the log should be displayed",
          "default": false
        },
        "log_file": {
          "type": "boolean",
          "description": "Whether the log should be written into a file",
          "default": true
        },
        "rotation_time": {
          "type": "string",
          "description": "Time between log file rotations",
          "enum": [
            "none",
            "hourly",
            "daily",
            "weekly",
            "monthly"
          ],
          "default": "daily"
        },
        "max_history": {
          "type": "integer",
          "description": "Amount of console commands saved",
          "default": 50,
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "server"
  ],
  "additionalProperties": false
}
